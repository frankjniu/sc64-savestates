# Ignore editor specific config folders/files
/.vscode

# Ignore compilation result directories
/build
/output
/docs/api
/_site

# Ignore generated files in the libdragon FS
/filesystem/Firple-Bold.font64
/filesystem/FiraMonoBold.font64
/filesystem/*.wav64
/filesystem/*.sprite

# SC64SS: ignore the intermediates src/boot/hook/build.sh leaves beside its sources
# (its outputs, src/boot/hook_blob.c and hook_blob.h, are tracked)
/src/boot/hook/*.o
/src/boot/hook/*.elf
/src/boot/hook/*.bin
/src/boot/hook/hook.map

# Ignore external development tools
/tools/*

# Ignore any N64 ROM
**/*.n64
**/*.v64
**/*.z64

# Ignore exe files
*.exe

# Ignore macOS filesystem cruft
.DS_Store
